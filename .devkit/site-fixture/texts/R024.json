  "verses": [
    {
      "v": 0,
      "tur": "Kətwo malke.",
      "tr": "Es war ein König."
    },
    {
      "v": 1,
      "tur": "U malke kətle abro.",
      "tr": "Der König hatte einen Sohn."
    },
    {
      "v": 2,
      "tur": "U abro ḥze u ktowo.",
      "tr": "Der Sohn sah das Buch."
    },
    {
      "v": 3,
      "tur": "U ktowo kətwo harke.",
      "tr": "Das Buch war hier."
    },
    {
      "v": 4,
      "tur": "səmle u ktowo ʕal u ṭawle.",
      "tr": "Er legte das Buch auf den Tisch."
    },
    {
      "v": 5,
      "tur": "səmle šuġlo ṭowo.",
      "tr": "Er machte gute Arbeit."
    },
    {
      "v": 6,
      "tur": "ko-soyəm u ktowo.",
      "tr": "Er legt das Buch hin."
    },
    {
      "v": 7,
      "tur": "sim u ktowo harke.",
      "tr": "Lege das Buch hierhin."
    },
    {
      "v": 8,
      "tur": "U abro zəlle.",
      "tr": "Der Sohn ging weg."
    },
    {
      "v": 9,
      "tur": "Harke saliq i ḥəkkoye.",
      "tr": "Hier endet die Geschichte."
    }
  ],
