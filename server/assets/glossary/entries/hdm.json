              ],
              "note": null,
              "raw": "omər kle u=šamʕo b-iḏe. hbīṭ u=qašo, mayəṯ ʻ“dort ist die Kerze, die er in der Hand hält”, sagte der Pfaffe und starb vor Entsetzenʼ; 126; prs 223/30;"
            },
            {
              "id": "hdm.I.d.preterit~2.2",
              "sense": null,
              "turoyo": "qām azzino hul d-aṯyono dísane məḷḷux gd-oṯeno w-l=aṯət hīč l=qamayt-ayḏi hbiṭono",
              "translation": "I went (from home) until I came (to you). You have told me again and again: “I will come” – but you did not come toward me at all, and I was scared",
              "refs": [
                {
                  "raw": "JL 6.10.18",
                  "kind": "jl",
                  "textId": null,
                  "verse": null
                }
              ],
              "note": null,
              "raw": "qām azzino hul d-aṯyono dísane məḷḷux gd-oṯeno w-l=aṯət hīč l=qamayt-ayḏi hbiṭono ‘I went (from home) until I came (to you). You have told me again and again: “I will come” – but you did not come toward me at all, and I was scared’ JL 6.10.18;"
            }
          ]
        }
