        {
          "id": "ymy.I.t.infectum",
          "label": "Infectum",
          "rawLabel": "Infectum",
          "detransitive": false,
          "examples": [
            {
              "id": "ymy.I.t.infectum.1",
              "sense": null,
              "turoyo": "i=ziyara d-i=Xalbúbe-yo, ġắlabe fáḏ̣əl-yo, nošo lo=k-yome-ba b-dugle",
              "translation": "das ist der Wallfahrtsort von Chalbûbe, derselbe ist ganz ausgezeichnet wirksam! niemand kann dabei falsch schwören!",
              "refs": [
                {
                  "raw": "686",
                  "kind": "grammar-page",
                  "textId": null,
                  "verse": null
                },
                {
                  "raw": "prs 199/5",
                  "kind": "prs",
                  "textId": null,
                  "verse": null
                }
              ],
              "note": null,
              "raw": "i=ziyara d-i=Xalbúbe-yo, ġắlabe fáḏ̣əl-yo, nošo lo=k-yome-ba b-dugle ʻdas ist der Wallfahrtsort von Chalbûbe, derselbe ist ganz ausgezeichnet wirksam! niemand kann dabei falsch schwören!ʼ; 686; prs 199/5;"
            },
            {
              "id": "ymy.I.t.infectum.2",
              "sense": null,
              "turoyo": "mədli ḥḏo=ḥabṯo, hayo-ste, ko-yoménan-xu, fəlge=d-u=gald-ayḏa lə=čīk b-femi maḥtoli b-i=dukṯo",
              "translation": "ich nahm eine einzige (Olive). Und auch diese, ich versichere euch, nicht einmal die Hälfte davon habe ich in den Mund gesteckt und legte sie wieder hin",
              "refs": [
                {
                  "raw": "LB 109",
                  "kind": "lb",
                  "textId": null,
                  "verse": null
                }
              ],
              "note": null,
              "raw": "mədli ḥḏo=ḥabṯo, hayo-ste, ko-yoménan-xu, fəlge=d-u=gald-ayḏa lə=čīk b-femi maḥtoli b-i=dukṯo ‘ich nahm eine einzige (Olive). Und auch diese, ich versichere euch, nicht einmal die Hälfte davon habe ich in den Mund gesteckt und legte sie wieder hin’; LB 109;"
            },
            {
              "id": "ymy.I.t.infectum.3",
              "sense": null,
              "turoyo": "b-aḥ=ḥaye d-aloho g-imena, w-bəṯṯər b-rišox g-imena, d-lo=doʕrina xalye ho d-lu=saymina namūs",
              "translation": "Und beim Leben Gottes und dann bei deinem Haupte schwören wir, daß wir nicht unverrichteter Sache zurückkehren werden, nicht eher, als bis wir ehrenvoll gekämpft haben",
              "refs": [
                {
                  "raw": "29/194",
                  "kind": "text",
                  "textId": "R029",
                  "verse": 194
                }
              ],
              "note": null,
              "raw": "b-aḥ=ḥaye d-aloho g-imena, w-bəṯṯər b-rišox g-imena, d-lo=doʕrina xalye ho d-lu=saymina namūs ‘Und beim Leben Gottes und dann bei deinem Haupte schwören wir, daß wir nicht unverrichteter Sache zurückkehren werden, nicht eher, als bis wir ehrenvoll gekämpft haben’; 29/194"
            }
          ]
