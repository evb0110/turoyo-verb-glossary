        {
          "id": "dyl.III.t.infectum",
          "label": "Infectum",
          "rawLabel": "Infectum",
          "detransitive": false,
          "examples": [
            {
              "id": "dyl.III.t.infectum.1",
              "sense": null,
              "turoyo": "hawo g-zobaṭle safruno mede aw ṭayrǝ́k mede b-lebe. w g-madəl aʕle b-iḏoṯe, faqat əšme lə=k-omal-le",
              "translation": "derjenige nimmt sich einen Vogel oder ein Vögelchen in den Sinn und beschreibt den Vogel andeutend mit den Händen, aber ohne seinen Namen zu nennen",
              "refs": [
                {
                  "raw": "544",
                  "kind": "grammar-page",
                  "textId": null,
                  "verse": null
                },
                {
                  "raw": "94/436-437",
                  "kind": "text",
                  "textId": "R094",
                  "verse": 436
                }
              ],
              "note": null,
              "raw": "hawo g-zobaṭle safruno mede aw ṭayrǝ́k mede b-lebe. w g-madəl aʕle b-iḏoṯe, faqat əšme lə=k-omal-le ʻderjenige nimmt sich einen Vogel oder ein Vögelchen in den Sinn und beschreibt den Vogel andeutend mit den Händen, aber ohne seinen Namen zu nennenʼ; 544; 94/436-437;"
            },
            {
              "id": "dyl.III.t.infectum.2",
              "sense": null,
              "turoyo": "elo fayəš lebi xəd ko-madili",
              "translation": "aber es war, als ob mein Herz mir eine Ahnung eingäbe",
              "refs": [
                {
                  "raw": "544-545",
                  "kind": "grammar-page",
                  "textId": null,
                  "verse": null
                },
                {
                  "raw": "52/76",
                  "kind": "text",
                  "textId": "R052",
                  "verse": 76
                }
              ],
              "note": null,
              "raw": "elo fayəš lebi xəd ko-madili ʻaber es war, als ob mein Herz mir eine Ahnung eingäbeʼ; 544-545; 52/76;"
            }
          ]
        },
