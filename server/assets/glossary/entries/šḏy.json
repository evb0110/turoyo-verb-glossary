        },
        {
          "n": "2",
          "gloss": "(bəṯr-) hinter jm. herstürzen, ihn verfolgen;"
        },
        {
          "n": "3",
          "gloss": "loslassen, anzünden (Feuer);"
        },
        {
          "n": "4",
          "gloss": "hinter jemand herstürzen, ihn verfolgen."
        }
      ],
