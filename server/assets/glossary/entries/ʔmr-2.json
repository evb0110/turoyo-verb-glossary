            },
            {
              "id": "ʔmr-2.II.t.preterit.2",
              "sense": null,
              "turoyo": "məd-šaməʕ u=babo u=malko haṯe, mʔamalle ḥatta d-kul bayto d-amṭən ṭaʕno d-qayse",
