  "idioms": [
    {
      "id": "mṭy-2.idiom.1",
      "raw": "mṭele bqamuṯ- to bring an intercessor, e.g.  mṭeli bqamuṯi Fәnǧan Aġa – ‘I brought Fәnǧan Aġa as an intercessor with me’, lit. ‘I brough FA in front of me’. (FA 54)",
      "headword": "mṭele bqamuṯ- to bring an intercessor, e.g.  mṭeli bqamuṯi Fәnǧan Aġa –"
    },
    {
      "id": "mṭy-2.idiom.2",
      "raw": "gәmḥalqat ruḥux gabe = koṭәlbat šubqono mine, gәblat ḥa zlam rabo b qamuṯux, lašan dә msamaḥlux ‘You ask him for forgiveness, you bring an intercessor with you so that he forgives you.’ (Ilyas p.c. 5/11/23)",
      "headword": "gәmḥalqat ruḥux gabe = koṭәlbat šubqono mine, gәblat ḥa zlam rabo b qamuṯux, lašan dә msamaḥlux"
    }
  ],
