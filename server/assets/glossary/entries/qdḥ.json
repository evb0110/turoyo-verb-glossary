            {
              "id": "qdḥ.I.t.infectum.1",
              "sense": "1",
              "turoyo": "nafəl leba b-u=kurrŭko ġắlabe, w ḥəlla bayn i=awərre d-bayn ʕayne, k-qodəḥ nuro",
