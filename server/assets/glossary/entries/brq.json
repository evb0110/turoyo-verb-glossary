              ],
              "note": null,
              "raw": "yawmo d-qáyṭo-yo, hawa basǝ́mto-yo; i=šəmšo k-mábrəqo w k-obo šḥanṯo l-hawīr ʻes ist ein Sommertag; das Wetter ist schön, die Sonne leuchtet hell und spendet Wärme ringsumherʼ; 4/11;"
            },
            {
              "id": "brq.III.t.infectum.3",
              "sense": null,
              "turoyo": "kile kit b-iḏa šayro d-almās, k-mabrəq ax d-u=kukwo",
