          "detransitive": false,
          "examples": [
            {
              "id": "myṣ.I.t.infectum.1",
              "sense": null,
              "turoyo": "hamma ʕaṣriye gəm-moyəṣ ṣawʕa, gəm-moyaṣ-la gəm-moyaṣ-la hul d-əmmo tarp w nəflo",
              "translation": "am Abend saugte er immer an ihrem Finger, saugte und saugte, bis sie “plumps” hinfiel",
              "refs": [
                {
                  "raw": "515",
                  "kind": "grammar-page",
                  "textId": null,
                  "verse": null
                },
                {
                  "raw": "96/246",
                  "kind": "text",
                  "textId": "R096",
                  "verse": 246
                }
              ],
              "note": null,
              "raw": "hamma ʕaṣriye gəm-moyəṣ ṣawʕa, gəm-moyaṣ-la gəm-moyaṣ-la hul d-əmmo tarp w nəflo ʻam Abend saugte er immer an ihrem Finger, saugte und saugte, bis sie “plumps” hinfielʼ; 515; 96/246;"
            },
            {
              "id": "myṣ.I.t.infectum.2",
              "sense": null,
              "turoyo": "b-lalyo, u=nsān i=naqqa d-k-owe bə-ḥliṯo d-i=šanṯo kə-mḥalqi, ruḥayye, l-laltaḥ, ʕal u=ḥa d-kət-yo damixo, k-bodən, k-mayṣi u=admayḏe",
              "translation": "des Nachts, wenn der Mensch im schönsten Schlafe liegt, lassen sie (die Wanzen) sich auf den Schläfer herunterfallen und beginnen sein Blut zu saugen",
              "refs": [
                {
                  "raw": "1/24",
                  "kind": "text",
                  "textId": "R001",
                  "verse": 24
                }
              ],
              "note": null,
              "raw": "b-lalyo, u=nsān i=naqqa d-k-owe bə-ḥliṯo d-i=šanṯo kə-mḥalqi, ruḥayye, l-laltaḥ, ʕal u=ḥa d-kət-yo damixo, k-bodən, k-mayṣi u=admayḏe ‘des Nachts, wenn der Mensch im schönsten Schlafe liegt, lassen sie (die Wanzen) sich auf den Schläfer herunterfallen und beginnen sein Blut zu saugen’; 1/24;"
            }
          ]
        },
