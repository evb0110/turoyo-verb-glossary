[{"id": "a1eb88992792", "entryId": "klpt", "kind": "gloss-change", "stage": "synthesis", "target": {"stemId": "klpt.I", "sense": "1", "field": "gloss"}, "summary": "Sense 1: revise the gloss", "before": "(Detrans.) halb entschälen;", "after": "(Detrans.) sich teilweise entschälen;", "data": {"detransitive": true}, "rationale": "The wheat is the subject and its husk separates; the old active infinitive 'halb entschälen' obscures the Detransitive meaning. Partiality is inherited, not quantified by this verse.", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/klpt", "date": ""}}, {"id": "3de9e5a44325", "entryId": "klpt", "kind": "note", "stage": "synthesis", "target": {}, "summary": "94/251 erläutert das Verb durch Ablösen der Schale. Die Stelle enthält kein grammatisches Agens des Verbs; die anschließende Kleietrennung ist ein anderer Arbeitsschritt.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R094", "v": 251, "cite": "94/251"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/klpt", "date": ""}}, {"id": "c7251d6b4c0f", "entryId": "klpt", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Der einzige gelieferte Beleg ist bereits vorhanden. Keine zusätzliche Beispielzeile, kein neuer Kasten und keine neue Bedeutung.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/klpt", "date": ""}}, {"id": "8748c585fdf2", "entryId": "klpt", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Der I-Eintrag und seine vierradikalig wirkenden Grundformen bleiben geerbt erhalten; eine Umklassifikation zu Q lässt sich aus dem Einzelbeleg nicht sicher durchführen.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/klpt", "date": ""}}, {"id": "d007ebd77961", "entryId": "klpt", "kind": "question", "stage": "synthesis", "target": {}, "summary": "Ist die geerbte Einschränkung 'halb' als nur teilweise Entschälung sachlich richtig? Der Vers nennt keinen Anteil.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/klpt", "date": ""}}, {"id": "9d93be2be52c", "entryId": "klpt", "kind": "question", "stage": "synthesis", "target": {}, "summary": "Soll das geerbte Grundformpaar mkalpət/mikalpət als Q statt I klassifiziert werden? Bitte das vollständige Paradigma prüfen.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/klpt", "date": ""}}]