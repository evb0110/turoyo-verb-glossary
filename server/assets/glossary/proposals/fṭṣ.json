[{"id": "a7ff43c69cfe", "entryId": "fṭṣ", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "fṭṣ.I", "boxId": "fṭṣ.I.d.infectum-wa", "exampleId": "fṭṣ.I.d.infectum-wa.1", "field": "translation"}, "summary": "Correct the animal: cow → ox", "before": "the cow", "after": "the ox", "data": {"confidence": "high"}, "rationale": "The verse identifies the animal as u tawrayḏan, 'our ox', and the supplied German reads 'Unser Ochse'. The inserted subject '[the cow]' gives the wrong sex of the animal; retain the editorial brackets while correcting the noun.", "evidence": [], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P014", "date": "2026-10-25"}}, {"id": "adbd27d81d04", "entryId": "fṭṣ", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "fṭṣ.I", "boxId": "fṭṣ.I.d.infectum-wa", "exampleId": "fṭṣ.I.d.infectum-wa.2", "field": "translation"}, "summary": "Correct our cow → our ox", "before": "our cow", "after": "our ox", "data": {"confidence": "high"}, "rationale": "The quoted Turoyo explicitly has u=tawr-ayḏan, and the supplied German reads 'unser Ochs'. Translate the male draught animal as 'our ox'.", "evidence": [], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P014", "date": "2026-10-25"}}, {"id": "feb74ab30ff9", "entryId": "fṭṣ", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "fṭṣ.I", "boxId": "fṭṣ.I.d.preterit", "sense": "D1"}, "summary": "example for sense 1 in Preterit (60/208)", "before": null, "after": null, "data": {"box": "Preterit", "detransitive": true, "turoyo": "U lalyo qamoyo lo daməx gaba. I kačke fṭiṣo məlla: “Adlalyo lo daməx.”", "translation": "In der ersten Nacht schlief er nicht bei ihr. Das Mädchen wollte wohl vor Ärger ersticken und sprach: \"Diese Nacht hat er nicht bei mir geschlafen.\"", "ref": "60/208", "gate": {"ok": true, "reason": null}}, "rationale": "Fills a thin sense cell with a self-contained context.", "evidence": [{"textId": "R060", "v": 208, "cite": "60/208"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/fṭṣ", "date": ""}}, {"id": "4c0f9222d680", "entryId": "fṭṣ", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "fṭṣ.I", "boxId": "fṭṣ.I.d.preterit", "sense": "D1"}, "summary": "example for sense 1 in Preterit (70/217)", "before": null, "after": null, "data": {"box": "Preterit", "detransitive": true, "turoyo": "Manḥatte a tloṯo bu karawo əmmi: \"Fṭiṣina!\"", "translation": "So ließen sie alle drei hinunter. Sie riefen alle: \"Wir ersticken!\"", "ref": "70/217", "gate": {"ok": true, "reason": null}}, "rationale": "Fills a thin sense cell with a self-contained context.", "evidence": [{"textId": "R070", "v": 217, "cite": "70/217"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/fṭṣ", "date": ""}}, {"id": "9c496f65c732", "entryId": "fṭṣ", "kind": "gloss-change", "stage": "synthesis", "target": {"stemId": "fṭṣ.I", "sense": "D1", "field": "gloss"}, "summary": "Sense 1: revise the gloss", "before": "sich ersticken", "after": "(Detrans.) ersticken, keine Luft bekommen, krepieren", "data": {"detransitive": true}, "rationale": "Replaces potentially self-causing 'sich ersticken' by non-agentive suffocation. The existing earth, well and ox examples and the new plural distress report all describe the affected subject, not self-strangling.", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/fṭṣ", "date": ""}}, {"id": "a9c8c9d566e1", "entryId": "fṭṣ", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Active fṭəṣṣe at 29/279 has the girls as agents and the buried man as patient. Detransitive forms present an affected subject with no suffocating agent in the clause.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R029", "v": 279, "cite": "29/279"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/fṭṣ", "date": ""}}, {"id": "129cd7bfff68", "entryId": "fṭṣ", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Detransitive Preterit forms report current or impending suffocation: fṭəṣno and plural Fṭiṣina need not entail completed death. The plural form adds useful paradigm evidence.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/fṭṣ", "date": ""}}, {"id": "cbd6be4acf7b", "entryId": "fṭṣ", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Infectum-wa with g- occurs in counterfactual rescue consequences at 44/95 and 44/114. The examples are already in the entry and are not duplicated.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R044", "v": 95, "cite": "44/95"}, {"textId": "R044", "v": 114, "cite": "44/114"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/fṭṣ", "date": ""}}, {"id": "4b1dc55eb6bd", "entryId": "fṭṣ", "kind": "note", "stage": "synthesis", "target": {}, "summary": "The supplied gməfṭəš at 29/275 has š where the entry has ṣ. Context identifies the suffocation episode, but no source spelling is silently regularised.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R029", "v": 275, "cite": "29/275"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/fṭṣ", "date": ""}}, {"id": "a5a17290fbbe", "entryId": "fṭṣ", "kind": "question", "stage": "synthesis", "t