[{"id": "711d4c45cf29", "entryId": "frs", "kind": "fix-citation", "stage": "proofreading", "target": {"stemId": "frs.I", "field": "refs", "boxId": "frs.I.t.preterit", "exampleId": "frs.I.t.preterit.3"}, "summary": "Rejoin the split Prym–Socin page number 146", "before": "prs 1 46/15, 25", "after": "prs 146/15, 25", "data": {"confidence": "high"}, "rationale": "The raw reference splits page 146 into 1 46, producing the spurious parsed Ritter reference 46/15. The additional bed-spreading episode is in PrS 52/19 and 52/26. Its printed-page neighborhood is independently confirmed by the supplied dictionary: qalyūn cites PrS 146/15, 26 and mxadde cites PrS 146/16, 26, matching the pipe and cushion in the same episode. Preserve both line numbers and join the page digits.", "evidence": [], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P011", "date": "2026-10-25"}}, {"id": "c91725a9f7f4", "entryId": "frs", "kind": "fix-citation", "stage": "proofreading", "target": {"stemId": "frs.I", "field": "refs", "boxId": "frs.I.t.preterit", "exampleId": "frs.I.t.preterit.6"}, "summary": "Extend the citation to include the second quoted verse", "before": "JL 17.5.14", "after": "JL 17.5.14-15", "data": {"confidence": "high"}, "rationale": "Bəṯr me d frəslan w našəf is in verse 14, but Gmalimiwayna aḥ=ḥeṭanək d similan barġal is in verse 15. The quotation joins the two with an ellipsis and therefore requires both verses.", "evidence": [], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P011", "date": "2026-10-25"}}, {"id": "69b28c3b6257", "entryId": "frs", "kind": "fix-citation", "stage": "proofreading", "target": {"stemId": "frs.I", "field": "refs", "boxId": "frs.I.t.preterit", "exampleId": "frs.I.t.preterit.8"}, "summary": "Cite both verses of the lioness quotation", "before": "75/298", "after": "75/297-298", "data": {"confidence": "high"}, "rationale": "The words aṯyo ʕal i šeno d məllele u sowo aʕla maġela are in 75/297; Frəsla raġla begins 75/298. The automatic best match at 75/287 is not the quotation. The actual passage spans 297–298.", "evidence": [], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P011", "date": "2026-10-25"}}, {"id": "72794dc8c5cd", "entryId": "frs", "kind": "move-example", "stage": "proofreading", "target": {"stemId": "frs.I", "field": "sense", "boxId": "frs.I.t.preterit", "exampleId": "frs.I.t.preterit.8"}, "summary": "File the lioness stretching her leg under sense 3", "before": "2", "after": "3", "data": {"to_sense": "3", "confidence": "high"}, "rationale": "The target verb frəsla raġla describes stretching a leg, the same construction as fras raġlux already filed under sense 3 strecken. The cited text 75/298 confirms that action.", "evidence": [{"textId": "R075", "v": 298, "cite": "75/298"}], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P011", "date": "2026-10-25"}}, {"id": "9a21dbf58631", "entryId": "frs", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "frs.I", "field": "translation", "boxId": "frs.I.t.preterit", "exampleId": "frs.I.t.preterit.4"}, "summary": "Correct the past tense 'breiten' to 'breiteten'", "before": "und breiten sie", "after": "und breiteten sie", "data": {"confidence": "high"}, "rationale": "The coordinated narrative verbs are past tense: sie brachten ... und breiteten. The present-tense form breiten is an evident slip.", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P011", "date": "2026-10-25"}}, {"id": "ca80f0c1b12c", "entryId": "frs", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "frs.I", "field": "translation", "boxId": "frs.I.t.preterit", "exampleId": "frs.I.t.preterit.8"}, "summary": "Correct 'lied down' to 'lay down'", "before": "lied down", "after": "lay down", "data": {"confidence": "high"}, "rationale": "The past tense of lie down is lay down. Lied is the past tense of tell an untruth and is wrong for maġela, the lioness lying down.", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P011", "date": "2026-10-25"}}, {"id": "cbc282db0608", "entryId": "frs", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "frs.I", "field": "translation", "boxId": "frs.I.t.preterit", "exampleId": "frs.I.t.preterit.6"}, "summary": "Correct 'zum Weizengrütze' to 'zu Weizengrütze'", "before": "zum Weizengrütze", "after": "zu Weizengrütze", "data": {"confidence": "high"}, "rationale": "Weizengrütze is feminine; zum is impossible here. The edition has den wir zu Weizengrütze gemacht hatten.", "evidence": [], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P011", "date": "2026-10-25"}}, {"id": "f7993b9408bc", "entryId": "frs", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "frs.I", "field": "translation", "boxId": "frs.I.t.preterit", "exampleId": "frs.I.t.preterit.7"}, "summary": "Correct 'brough' to 'brought'", "before": "He brough a piece", "after": "He brought a piece", "data": {"confidence": "high"}, "rationale": "Brough is a misspelling of the past tense brought.", "evidence": [], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P011", "date": "2026-10-25"}}]