[{"id": "69f5dc777834", "entryId": "šmʕ", "kind": "fix-text", "stage": "proofreading", "target": {"field": "turoyo", "stemId": "šmʕ.I", "boxId": "šmʕ.I.t.infectum", "exampleId": "šmʕ.I.t.infectum.4"}, "summary": "Correct the final consonant of šoməʕ.", "before": "šoməḥ", "after": "šoməʕ", "data": {"confidence": "high"}, "rationale": "The supplied Turoyo of 24/278 has kšoməʕ, with ʕ, agreeing with the entry's root šmʕ and base form šoməʕ. The entry instead has ḥ; this is not a clitic or vowel normalization.", "evidence": [{"textId": "R024", "v": 278, "cite": "24/278"}], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P078", "date": "2026-10-25"}}, {"id": "7c28ba16fca8", "entryId": "šmʕ", "kind": "fix-text", "stage": "proofreading", "target": {"field": "turoyo", "stemId": "šmʕ.I", "boxId": "šmʕ.I.t.infectum-wa", "exampleId": "šmʕ.I.t.infectum-wa.4"}, "summary": "Restore the first-person ending in šŭmaʕno-wo.", "before": "lu=šŭmaʕ-wo", "after": "lu=šŭmaʕno-wo", "data": {"confidence": "high"}, "rationale": "The supplied verse has 'lo šumaʕnowo', first-person singular, matching maṯnowo and the translation 'ich ... gehört hätte'. The entry omits no and thus changes the person of the hearing verb.", "evidence": [{"textId": "R030", "v": 18, "cite": "30/18"}], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P078", "date": "2026-10-25"}}, {"id": "40b3ea861116", "entryId": "šmʕ", "kind": "fix-text", "stage": "proofreading", "target": {"field": "turoyo", "stemId": "šmʕ.I", "boxId": "šmʕ.I.t.infectum-wa", "exampleId": "šmʕ.I.t.infectum-wa.3"}, "summary": "Restore y in the possessed form of walaye.", "before": "wala-ayḏe", "after": "walay-ayḏe", "data": {"confidence": "high"}, "rationale": "The cited Turoyo reads 'Qm i walayayḏe'; the entry has wala-ayḏe, lacking the stem-final y before the possessive ending. The same entry batch has walay-ayḏe i