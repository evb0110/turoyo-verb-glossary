[{"id": "10e3487ef708", "entryId": "dmʕ", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Both supplied occurrences are already quoted:11/327 under I Infectum and84/34 within II Detransitive Preterit84/33–34. Thin-cell priority does not justify printing the same passage twice.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R011", "v": 327, "cite": "11/327"}, {"textId": "R084", "v": 34, "cite": "84/34"}, {"textId": "R084", "v": 33, "cite": "84/33"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/dmʕ", "date": ""}}, {"id": "47a3dfd1f40b", "entryId": "dmʕ", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Eyes are the overt subject in both passages. Joy in11/327 and sunlight in84/33–34 are stimuli/causes; neither requires a separate lexical sense.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R011", "v": 327, "cite": "11/327"}, {"textId": "R084", "v": 33, "cite": "84/33"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/dmʕ", "date": ""}}, {"id": "e654d08d0e3c", "entryId": "dmʕ", "kind": "note", "stage": "synthesis", "target": {}, "summary": "II describes a bodily process without an expressed agent, while I also describes spontaneous tearing. The two attestations do not establish a systematic semantic opposition between the stems.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/dmʕ", "date": ""}}, {"id": "c8b1f2e8ba7b", "entryId": "dmʕ", "kind": "question", "stage": "synthesis", "target": {}, "summary": "Is there a stable dialectal or aspectual difference between I and II? One example per contextual type cannot establish it.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/dmʕ", "date": ""}}, {"id": "dc2d361eb4fe", "entryId": "dmʕ", "kind": "question", "stage": "synthesis", "target": {}, "summary": "Compare11/327 source gdəmʕi with glossary gəd-dumʕi against the edition before any fix-text; preserve both supplied witnesses.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/dmʕ", "date": ""}}]