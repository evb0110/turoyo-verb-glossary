[{"id": "93cc26817509", "entryId": "šyr-2", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "šyr-2.III", "boxId": "šyr-2.III.t.infectum", "sense": "1"}, "summary": "example for sense 1 in Infectum (56/61)", "before": null, "after": null, "data": {"box": "Infectum", "detransitive": false, "turoyo": "Ono gmaširono šira aʕlux.", "translation": "Ich werde dir sagen, was du tun sollst.", "ref": "56/61", "gate": {"ok": true, "reason": null}}, "rationale": "Vers und Kontext stützen I will advise you. Ausgewählter Beleg für eine dünn besetzte Zelle oder eine neue Form/Bedeutung.", "evidence": [{"textId": "R056", "v": 61, "cite": "56/61"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šyr-2", "date": ""}}, {"id": "d17d4615c0b8", "entryId": "šyr-2", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "šyr-2.III", "boxId": "šyr-2.III.t.imperativ", "sense": "1"}, "summary": "example for sense 1 in Imperativ (96/334)", "before": null, "after": null, "data": {"box": "Imperativ", "detransitive": false, "turoyo": "De, mašər aʕli!", "translation": "Dann gib mir einen Rat!", "ref": "96/334", "gate": {"ok": true, "reason": null}}, "rationale": "Vers und Kontext stützen give me advice. Ausgewählter Beleg für eine dünn besetzte Zelle oder eine neue Form/Bedeutung.", "evidence": [{"textId": "R096", "v": 334, "cite": "96/334"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šyr-2", "date": ""}}, {"id": "5893d1671e86", "entryId": "šyr-2", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "šyr-2.III", "boxId": "šyr-2.III.t.preterit", "sense": "1"}, "summary": "example for sense 1 in Preterit (113/56)", "before": null, "after": null, "data": {"box": "Preterit", "detransitive": false, "turoyo": "i naqqa d azzele lu diwan, mašəlla li emo aʕle,", "translation": "So riet ihm die Mutter, als er zum Diwan ging.", "ref": "113/56", "gate": {"ok": true, "reason": null}}, "rationale": "Vers und Kontext stützen his mother advised him. Ausgewählter Beleg für eine dünn besetzte Zelle oder eine neue Form/Bedeutung.", "evidence": [{"textId": "R113", "v": 56, "cite": "113/56"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šyr-2", "date": ""}}, {"id": "a7818fa517a9", "entryId": "šyr-2", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "šyr-2.III", "boxId": "šyr-2.III.t.part-act", "sense": "1"}, "summary": "example for sense 1 in Part act. (113/142)", "before": null, "after": null, "data": {"box": "Part act.", "detransitive": false, "turoyo": "Aydarbo soyamno w nošo maširone stene layt,", "translation": "Wie soll ichs anstellen? Ratgeber sind auch nicht da,", "ref": "113/142", "gate": {"ok": true, "reason": null}}, "rationale": "Vers und Kontext stützen people who give advice / advisers. Ausgewählter Beleg für eine dünn besetzte Zelle oder eine neue Form/Bedeutung.", "evidence": [{"textId": "R113", "v": 142, "cite": "113/142"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šyr-2", "date": ""}}, {"id": "28770db5862a", "entryId": "šyr-2", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "šyr-2.III", "boxId": "šyr-2.III.t.imperativ", "sense": "1"}, "summary": "example for sense 1 in Imperativ (113/143)", "before": null, "after": null, "data": {"box": "Imperativ", "detransitive": false, "turoyo": "W amaruli, mašeru aʕli: ono, abnoṯe latli w aḥunoni stene lo ḥərralli, amaruli, be mən soyamno!", "translation": "Sagt mir etwas! Ratet mir! Ich habe keine Töchter, und meine Brüder haben mich im Stich gelassen. Sagt mir, was ich tun soll!", "ref": "113/143", "gate": {"ok": true, "reason": null}}, "rationale": "Vers und Kontext stützen advise him. Ausgewählter Beleg für eine dünn besetzte Zelle oder eine neue Form/Bedeutung.", "evidence": [{"textId": "R113", "v": 143, "cite": "113/143"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šyr-2", "date": ""}}, {"id": "f2202a134cfa", "entryId": "šyr-2", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "šyr-2.III", "boxId": "šyr-2.III.t.preterit", "sense": "1"}, "summary": "example for sense 1 in Preterit (113/194)", "before": null, "after": null, "data": {"box": "Preterit", "detransitive": false, "turoyo": "haṯe stene mašəlla aʕla.", "translation": "So riet sie ihr.", "ref": "113/194", "gate": {"ok": true, "reason": null}}, "rationale": "Vers und Kontext stützen gives Zamrud this advice. Ausgewählter Beleg für eine dünn besetzte Zelle oder eine neue Form/Bedeutung.", "evidence": [{"textId": "R113", "v": 194, "cite": "113/194"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šyr-2", "date": ""}}, {"id": "979fee5aa7b0", "entryId": "šyr-2", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Alle 26 Vorkommen gehören zu III 1 „Ratschläge geben“; keine neue Bedeutung nötig. ʕal markiert den Beratenen, indirekte Frage oder folgende Rede den Inhalt. Beratung ist ein anderer Rahmen als wechselseitiges Konsultieren mit b-.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šyr-2", "date": ""}}, {"id": "188bd3a32755", "entryId": "šyr-2", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Das zusätzliche Nomen šira in 24/288,56/61,67/4,67/7 verstärkt den bereits beratenden Verbstamm; ein solcher Beleg steht schon im Eintrag. Keine neue Light-verb-Bedeutung und keine doppelte Idiomatic phrase.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R024", "v": 288, "cite": "24/288"}, {"textId": "R056", "v": 61, "cite": "56/61"}, {"textId": "R067", "v": 4, "cite": "67/4"}, {"textId": "R067", "v": 7, "cite": "67/7"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šyr-2", "date": ""}}, {"id": "1589e58c895a", "entryId": "šyr-2", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Assimiliertes r+n in mašənno neben erweitertem maširono; Part act. maširono no ist als Prädikat vom durch g- gestützten Infectum gmaširono zu unterscheiden. Die ungewöhnliche finite Form wird mit Forschungsfrage beibehalten.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šyr-2", "date": ""}}, {"id": "3c3a46c67d32", "entryId": "šyr-2", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Die tierische Beraterin (Stute) ist bereits im Altbestand belegt; die Erzählfigur rechtfertigt keine neue Teilnehmererweiterung. Wiederholte vorhandene Beispiele 21/20,21/30,24/288,35/24,58/128,61/4,113/126 und Talay 1/105 nicht erneut aufgenommen.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R021", "v": 20, "cite": "21/20"}, {"textId": "R021", "v": 30, "cite": "21/30"}, {"textId": "R024", "v": 288, "cite": "24/288"}, {"textId": "R035", "v": 24, "cite": "35/24"}, {"textId": "R058", "v": 128, "cite": "58/128"}, {"textId": "R061", "v": 4, "cite": "61/4"}, {"textId": "R113", "v": 126, "cite": "113/126"}, {"textId": "Talay001", "v": 105, "cite": "Talay 1/105"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šyr-2", "date": ""}}, {"id": "d341296e2a62", "entryId": "šyr-2", "kind": "question", "stage": "synthesis", "target": {}, "summary": "Ist erweitertes 1sg.f gmaširono (56/61,62/254) sicher finites Infectum oder eine Konstruktion mit Part act.? g- und erste Person stützen hier die finite Zuordnung.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šyr-2", "date": ""}}, {"id": "b549b37c4b13", "entryId": "šyr-2", "kind": "question", "stage": "synthesis", "target": {}, "summary": "Bitte Entsprechung von prs 186/21 und PrS 66/6 prüfen; die identische Ratbitte nicht ohne Editionsabgleich als Zitierfehler ändern.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šyr-2", "date": ""}}]