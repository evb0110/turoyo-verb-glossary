[{"id": "b4b8d626e2c3", "entryId": "wṣl", "kind": "new-sense", "stage": "synthesis", "target": {"stemId": "wṣl.I", "sense": "1"}, "summary": "New sense 1: (mit l-) gelangen, ankommen", "before": null, "after": null, "data": {"label": "1", "gloss": "(mit l-) gelangen, ankommen", "type": "lexical", "extends": null, "detransitive": false}, "rationale": "An unprefixed motion form has the arriving participant as subject and l gabe as goal. It contrasts with the inherited II causative; only the Preterit base is attested.", "evidence": [{"textId": "R053", "v": 155, "cite": "53/155"}], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/wṣl", "date": ""}}, {"id": "33d41f545719", "entryId": "wṣl", "kind": "new-stem", "stage": "synthesis", "target": {"stemId": "wṣl.I"}, "summary": "New stem I (waṣəl/— (Infectum nicht belegt))", "before": null, "after": null, "data": {"stem": "I", "forms": "waṣəl/— (Infectum nicht belegt)"}, "rationale": "", "evidence": [], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/wṣl", "date": ""}}, {"id": "bad4ff626b33", "entryId": "wṣl", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "wṣl.I", "boxId": null, "sense": "1"}, "summary": "example for sense 1 in Preterit Intransitive (53/155)", "before": null, "after": null, "data": {"box": "Preterit Intransitive", "detransitive": false, "turoyo": "Madəllalle, ayko yo. Kəzze waṣəl l gabe.", "translation": "Man zeigte ihm den Weg zu dem Ort, wo er war. Er ging und gelangte zu ihm.", "ref": "53/155", "gate": {"ok": true, "reason": null}}, "rationale": "First stem I and Preterit Intransitive example, distinct from the existing II “make arrive/attach”.", "evidence": [{"textId": "R053", "v": 155, "cite": "53/155"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/wṣl", "date": ""}}, {"id": "1fd35fe255b1", "entryId": "wṣl", "kind": "note", "stage": "synthesis", "target": {}, "summary": "53/155 establishes I waṣəl with the arriver as subject and goal l gabe. There is no causative agent or separate transported patient, unlike the existing II gelangen lassen.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R053", "v": 155, "cite": "53/155"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/wṣl", "date": ""}}, {"id": "38c44e30db8b", "entryId": "wṣl", "kind": "note", "stage": "synthesis", "target": {}, "summary": "The new stem is accepted on one clear lexical and constructional attestation. Its base pair records waṣəl and an explicit gap for Infectum; no unattested paradigm member is supplied.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/wṣl", "date": ""}}, {"id": "90d520b4f0fc", "entryId": "wṣl", "kind": "note", "stage": "synthesis", "target": {}, "summary": "The preceding kəzze followed by bare waṣəl gives a motion sequence. The entry places the bare qaṭəl event form under Preterit Intransitive; the German past is supporting context rather than the basis for the box.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/wṣl", "date": ""}}, {"id": "d1b2e5f7d259", "entryId": "wṣl", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Preserve inherited II forms, sense numbering and examples. The arrival stem does not justify separating the inherited attachment and caused-arrival glosses in this run.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/wṣl", "date": ""}}, {"id": "93b3cdaac14d", "entryId": "wṣl", "kind": "note", "stage": "synthesis", "target": {}, "summary": "No light-verb idiom or participant extension requires a separate note.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/wṣl", "date": ""}}, {"id": "3fdb1fae8689", "entryId": "wṣl", "kind": "question", "stage": "synthesis", "target": {}, "summary": "Confirm the productive Infectum base and the inflectional status of this Arabic-derived I form. The single token does not establish a complete Preterit/Infectum pair.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/wṣl", "date": ""}}, {"id": "c363d3b90eb0", "entryId": "wṣl", "kind": "question", "stage": "synthesis", "target": {}, "summary": "Is I waṣəl ordinary across dialects or restricted to this narrative/contact register?", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/wṣl", "date": ""}}]