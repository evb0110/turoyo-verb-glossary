[{"id": "fcbbc18c0365", "entryId": "šlkḥ", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "šlkḥ.I", "field": "gloss"}, "summary": "Correct abhangen to abnagen in sense 2.", "before": "vom Knochen ablösen, abhangen (Fleisch);", "after": "vom Knochen ablösen, abnagen (Fleisch);", "data": {"sense": "2", "confidence": "high"}, "rationale": "Abhangen does not mean removing flesh from a bone. Sense 2 is explicitly illustrated by mšalkaḥla u=garmo, translated sie nagte den Knochen ab, which supports abnagen.", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P077", "date": "2026-10-25"}}, {"id": "b509ef9a1342", "entryId": "šlkḥ", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "šlkḥ.I", "boxId": "šlkḥ.I.t.infectum", "exampleId": "šlkḥ.I.t.infectum.1", "field": "translation"}, "summary": "Correct the article in mit dem Zunge.", "before": "mit dem Zunge", "after": "mit der Zunge", "data": {"confidence": "high"}, "rationale": "Zunge is feminine; the dative article is der. The supplied edition translation also reads mit der Zunge.", "evidence": [{"textId": "R075", "v": 46, "cite": "75/46"}], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P077", "date": "2026-10-25"}}]