[{"id": "7668050648c8", "entryId": "rwš", "kind": "move-example", "stage": "synthesis", "target": {"exampleId": "rwš.II.t.infectum.1", "boxId": "rwš.II.t.infectum", "field": null}, "summary": "Supply omitted sense number 1.", "before": null, "after": null, "data": {"to_sense": "1"}, "rationale": "Bare inherited shovelling form; retain its untranslated status.", "evidence": [], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/rwš", "date": ""}}, {"id": "c497fbeffe5e", "entryId": "rwš", "kind": "move-example", "stage": "synthesis", "target": {"exampleId": "rwš.II.t.infectum-wa.1", "boxId": "rwš.II.t.infectum-wa", "field": null}, "summary": "Supply omitted sense number 1.", "before": null, "after": null, "data": {"to_sense": "1"}, "rationale": "Existing earth-shovelling example.", "evidence": [], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/rwš", "date": ""}}, {"id": "dfbb8d107c20", "entryId": "rwš", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "rwš.II", "boxId": "rwš.II.t.infectum", "sense": "1"}, "summary": "example for sense 1 in Infectum (JTM 1.1/19)", "before": null, "after": null, "data": {"box": "Infectum", "detransitive": false, "turoyo": "Bəṯr məd mdaranne kəmrawšənne bu rawšo, kəmminale zəwoqo, <...>", "translation": "Wenn sie das Getreide geworfelt haben, schaufeln sie es mit der Schaufel auf einen Haufen – das nennt man zĭwoqo, <...>", "ref": "JTM 1.1/19", "gate": {"ok": true, "reason": null}}, "rationale": "First contextualized Infectum example; overt cognate instrument and plural object suffix, distinct from the inherited bare form.", "evidence": [{"textId": "JTM1.1", "v": 19, "cite": "JTM 1.1/19"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/rwš", "date": ""}}, {"id": "b6ada6a5d1cd", "entryId": "rwš", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Both occurrences checked. Active II has an overt earth object or a grain object indexed by -ne; b- marks the cognate shovel instrument. Neither clause is Detransitive.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/rwš", "date": ""}}, {"id": "d486a3433da8", "entryId": "rwš", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Infectum-wa describes repeated building work, while Infectum narrates the customary grain-processing sequence. The latter supplies a usable context where the inherited Infectum box had only an untranslated form.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/rwš", "date": ""}}, {"id": "4cd4a3e27a86", "entryId": "rwš", "kind": "note", "stage": "synthesis", "target": {}, "summary": "The denominal verb plus its cognate tool does not establish a light-verb idiom. zəwoqo names the processing step in context; no special new meaning of rwš is inferred from this noun.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/rwš", "date": ""}}, {"id": "63c24288a5c7", "entryId": "rwš", "kind": "question", "stage": "synthesis", "target": {}, "summary": "Does zəwoqo name the heap, the shovelling step, or a broader grain-cleaning operation? This distinction does not change the proposed shovelling sense.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/rwš", "date": ""}}, {"id": "40b24149e30e", "entryId": "rwš", "kind": "note", "stage": "synthesis", "target": {"stemId": "rwš.II", "sense": "1"}, "summary": "The patient can be grain as well as earth; shovelling into a heap is an application of the same action, not a separate lexical sense.", "before": null, "after": null, "data": {"type": "extension"}, "rationale": "", "evidence": [{"textId": "JTM1.1", "v": 19, "cite": "JTM 1.1/19"}, {"textId": "JL11.11", "v": 12, "cite": "JL 11.11/12"}], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/rwš", "date": ""}}]