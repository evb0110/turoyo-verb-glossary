[{"id": "4262c479efa0", "entryId": "ṣrf-1", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "ṣrf-1.I", "boxId": "ṣrf-1.I.t.infectum", "sense": "1"}, "summary": "example for sense 1 in Infectum (65/215)", "before": null, "after": null, "data": {"box": "Infectum", "detransitive": false, "turoyo": "W izux, šlaḥ qarʕe! Bu šarṭawo: amṭili qadaḥ mu admayḏe, gṣorafne!", "translation": "Geh hin und reiß ihm den Köpf ab! Mit der Bedingung: Bringe mir einen Becher von seinem Blut, daß ich es schlürfe!", "ref": "65/215", "gate": {"ok": true, "reason": null}}, "rationale": "Thin Infectum cell; 1sg prospective and explicit blood-as-drink context.", "evidence": [{"textId": "R065", "v": 215, "cite": "65/215"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ṣrf-1", "date": ""}}, {"id": "f3ddaf1a0304", "entryId": "ṣrf-1", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "ṣrf-1.I", "boxId": "ṣrf-1.I.t.infectum", "sense": "1"}, "summary": "example for sense 1 in Infectum (94/197)", "before": null, "after": null, "data": {"box": "Infectum", "detransitive": false, "turoyo": "Annaqla gdoṯina l ad dawġe. Ad dawġe ste, həm hawxa koṣərfənne ʕam u laḥmo", "translation": "Jetzt kommen wir zum Ayran. Den Ayran schlürft man so mit Brot.", "ref": "94/197", "gate": {"ok": true, "reason": null}}, "rationale": "Thin Infectum cell; plural generic consumers, topical object resumed by -ne, and bread accompaniment.", "evidence": [{"textId": "R094", "v": 197, "cite": "94/197"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ṣrf-1", "date": ""}}, {"id": "b4c52bcd032f", "entryId": "ṣrf-1", "kind": "note", "stage": "synthesis", "target": {}, "summary": "All five tokens fit the supplied stem senses. I denotes ingesting liquid; II denotes physiological absorption by organs. The ingestion/absorption distinction is already encoded by the stem glosses.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ṣrf-1", "date": ""}}, {"id": "0372298fa0e2", "entryId": "ṣrf-1", "kind": "note", "stage": "synthesis", "target": {}, "summary": "3/57, 67/24 and 73/339 are already quoted. Their thin-cell reader proposals are declined as duplicates.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R003", "v": 57, "cite": "3/57"}, {"textId": "R067", "v": 24, "cite": "67/24"}, {"textId": "R073", "v": 339, "cite": "73/339"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ṣrf-1", "date": ""}}, {"id": "d76ce2195a81", "entryId": "ṣrf-1", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Bare ṣorafle at 67/24 is Infectum; the -le does not by itself make it Preterit. Its self-benefit interpretation is plausible, while suffixes at 73/339 and 94/197 resume explicit objects.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R067", "v": 24, "cite": "67/24"}, {"textId": "R073", "v": 339, "cite": "73/339"}, {"textId": "R094", "v": 197, "cite": "94/197"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ṣrf-1", "date": ""}}, {"id": "d136d7131377", "entryId": "ṣrf-1", "kind": "note", "stage": "synthesis", "target": {}, "summary": "The cauldron in 73/339 stands for its contents in an exaggerated drinking scene; no container-destruction meaning is inferred.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R073", "v": 339, "cite": "73/339"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ṣrf-1", "date": ""}}, {"id": "6371af2a3afc", "entryId": "ṣrf-1", "kind": "note", "stage": "synthesis", "target": {}, "summary": "No new idiom or light-verb construction is established.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ṣrf-1", "date": ""}}, {"id": "4b4224b6de16", "entryId": "ṣrf-1", "kind": "question", "stage": "synthesis", "target": {}, "summary": "67/24: confirm the function of -le in ṣorafle, probably self-benefit alongside the explicit quantity object.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ṣrf-1", "date": ""}}, {"id": "96705261cce0", "entryId": "ṣrf-1", "kind": "note", "stage": "synthesis", "target": {"stemId": "ṣrf-1.I", "sense": "1"}, "summary": "Blood and Ayran join soup as ingested liquids; the action remains slurping down, without a new sense.", "before": null, "after": null, "data": {"type": "extension"}, "rationale": "", "evidence": [{"textId": "R065", "v": 215, "cite": "65/215"}, {"textId": "R094", "v": 197, "cite": "94/197"}], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ṣrf-1", "date": ""}}]