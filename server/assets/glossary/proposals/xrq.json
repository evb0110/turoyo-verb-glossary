[{"id": "d06095a8aa9e", "entryId": "xrq", "kind": "fix-structure", "stage": "synthesis", "target": {"exampleId": "xrq.I.d.preterit.1", "boxId": "xrq.I.d.preterit", "field": null}, "summary": "Vorhandenen Gleitbeleg dem expliziten Detransitive-Sinn 1 zuordnen.", "before": null, "after": null, "data": {}, "rationale": "ʕal-Schnee als Oberfläche, kickbedingt bewegter Zuber; weder Wasserpenetration noch transitive Schleifhandlung.", "evidence": [], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/xrq", "date": ""}}, {"id": "5d2c71abe00d", "entryId": "xrq", "kind": "new-form", "stage": "synthesis", "target": {"stemId": "xrq.I", "boxId": null, "sense": "2"}, "summary": "New box Preterit: example for sense 2 in Preterit (JL 16.7/23)", "before": null, "after": null, "data": {"box": "Preterit", "detransitive": false, "turoyo": "šləḥḥe i=qarišayḏe me ḥaṣe, w maḥtalle b qḏole, w xrəqqe, hul d mayəṯ,", "translation": "Sie zogen ihm den Gürtelriemen aus, den er um die Hüfte trug, legten ihn ihm um den Hals und schleiften ihn über den Boden, bis er starb,", "ref": "JL 16.7/23", "gate": {"ok": true, "reason": null}}, "rationale": "Neuer aktiver Sinn 2 und neue aktive Preterit-Box.", "evidence": [{"textId": "JL16.07", "v": 23, "cite": "JL 16.7/23"}], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/xrq", "date": ""}}, {"id": "38b82d33bbca", "entryId": "xrq", "kind": "new-sense", "stage": "synthesis", "target": {"stemId": "xrq.I", "sense": "2"}, "summary": "New sense 2: (über den Boden) schleifen", "before": null, "after": null, "data": {"label": "2", "gloss": "(über den Boden) schleifen", "type": "lexical", "extends": null, "detransitive": false}, "rationale": "Ein Beleg; explizite transitive Schleifsequenz, keine bloße Durchdringung.", "evidence": [{"textId": "JL16.07", "v": 23, "cite": "JL 16.7/23"}], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/xrq", "date": ""}}, {"id": "af5a9eac10f1", "entryId": "xrq", "kind": "new-sense", "stage": "synthesis", "target": {"stemId": "xrq.I", "sense": "1"}, "summary": "New sense 1: (Detrans.) (mit ʕal-) gleiten, schlittern", "before": null, "after": null, "data": {"label": "1", "gloss": "(Detrans.) (mit ʕal-) gleiten, schlittern", "type": "lexical", "extends": null, "detransitive": true}, "rationale": "Eigener Detransitive-Sinn zur vorhandenen Box, kein neuer Stamm oder neue Box.", "evidence": [{"textId": "LuF002", "v": 20, "cite": "LuF 2/20"}, {"textId": "LuF002", "v": 32, "cite": "LuF 2/32"}], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/xrq", "date": ""}}, {"id": "9ad3f393bf27", "entryId": "xrq", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "xrq.I", "boxId": "xrq.I.d.preterit", "sense": "1"}, "summary": "example for sense 1 in Preterit (LuF 2/32)", "before": null, "after": null, "data": {"box": "Preterit", "detransitive": true, "turoyo": "W mḥela raġla b arʕe du tašt, mṭawṭaḥlali bu šalwo, ʕal u talgo xrəqno.", "translation": "Dann gab sie dem Zuber einen Fusstritt und beförderte mich ins Tal hinab. Ich schlitterte über den Schnee.", "ref": "LuF 2/32", "gate": {"ok": true, "reason": null}}, "rationale": "Dünne bestehende Detransitive-Zelle, menschliches Subjekt und 1sg xrəqno statt 3sg xriq.", "evidence": [{"textId": "LuF002", "v": 32, "cite": "LuF 2/32"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/xrq", "date": ""}}, {"id": "dd68cd033e96", "entryId": "xrq", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Aktives xrəqqe trägt l-Agens nach q+l-Angleichung, Patient aus Gürtel-/Halskontext; Detransitive xriq/xrəqno hat bewegtes Subjekt und ʕal-Oberfläche. Beide lexikalischen Werte stehen getrennt von I.1 durchbrechen, dringen.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/xrq", "date": ""}}, {"id": "176254ffc889", "entryId": "xrq", "kind": "question", "stage": "synthesis", "target": {}, "summary": "JL 16.7/23: genaue Schleifart und notwendiger Bodenkontakt bestätigen. Kopfverweis JL 16.6 bleibt als ungeklärte Editions-/Lesungsangabe, nicht still ersetzen.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/xrq", "date": ""}}, {"id": "2aaaa1255b56", "entryId": "xrq", "kind": "question", "stage": "synthesis", "target": {}, "summary": "LuF 2/32: xrəqno als reduzierte Detransitive-Form zu xriq bestätigen; keine Normalisierung der Quellvokale.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/xrq", "date": ""}}, {"id": "46e5146b7218", "entryId": "xrq", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "xrq.I", "boxId": "xrq.I.t.infectum", "exampleId": "xrq.I.t.infectum.1", "field": "translation"}, "summary": "Restore the missing n in Regenschirm", "before": "Regeschirm", "after": "Regenschirm", "data": {"confidence": "high"}, "rationale": "Regeschirm is a misspelling of German Regenschirm in the parenthetical explanation.", "evidence": [], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P067", "date": "2026-10-25"}}]