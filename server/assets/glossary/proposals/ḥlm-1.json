[{"id": "366da5081e3f", "entryId": "ḥlm-1", "kind": "new-form", "stage": "synthesis", "target": {"stemId": "ḥlm-1.I", "boxId": null, "sense": "1"}, "summary": "New box Infectum-wa: example for sense 1 in Infectum-wa (JTM 2.3/4)", "before": null, "after": null, "data": {"box": "Infectum-wa", "detransitive": false, "turoyo": "Aq qarʕanək ḥulmiwo w huwewulle bəzarʕo šafiro, rabo b gawayye, qarʕe rabe <...>", "translation": "Diese Kürbisse wurden dick und hatten schöne große Kerne im Inneren. Es waren große Kürbisse <...>", "ref": "JTM 2.3/4", "gate": {"ok": true, "reason": null}}, "rationale": "New I Infectum-wa box; pumpkins become thick/plump, extending the cream participant.", "evidence": [{"textId": "JTM2.3", "v": 4, "cite": "JTM 2.3/4"}], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḥlm-1", "date": ""}}, {"id": "31bfa2e52dae", "entryId": "ḥlm-1", "kind": "new-sense", "stage": "synthesis", "target": {"stemId": "ḥlm-1.III", "sense": "1"}, "summary": "New sense 1: (Flüssigkeit) eindicken, dickflüssig machen;", "before": null, "after": null, "data": {"label": "1", "gloss": "(Flüssigkeit) eindicken, dickflüssig machen;", "type": "technical", "extends": null, "detransitive": false}, "rationale": "kmaḥləmile hat Handelnde und Objekt -le; der folgende Kochvorgang und dicke Sirupzustand erklären die Kausation. Ein klarer Beleg; Preterit-Basis nicht belegt.", "evidence": [{"textId": "JTM1.1", "v": 54, "cite": "JTM 1.1/54"}], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḥlm-1", "date": ""}}, {"id": "22677b29032c", "entryId": "ḥlm-1", "kind": "new-stem", "stage": "synthesis", "target": {"stemId": "ḥlm-1.III"}, "summary": "New stem III ([Preterit nicht belegt]/maḥləm)", "before": null, "after": null, "data": {"stem": "III", "forms": "[Preterit nicht belegt]/maḥləm"}, "rationale": "", "evidence": [], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḥlm-1", "date": ""}}, {"id": "7b0437f0c616", "entryId": "ḥlm-1", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "ḥlm-1.III", "boxId": null, "sense": "1"}, "summary": "example for sense 1 in Infectum (JTM 1.1/54)", "before": null, "after": null, "data": {"box": "Infectum", "detransitive": false, "turoyo": "W di ḥarire kmaqšalla zid, yaʕni kmaḥləmile, kṭorən d roṯəḥ ġalabe, dowe u ḥawdal ḥlimo <...>", "translation": "Den Traubensirup für die ḥărire lassen sie dicker werden, d.h. sie dicken ihn weiter ein und lassen ihn lange kochen, damit er dickflüssig wird.", "ref": "JTM 1.1/54", "gate": {"ok": true, "reason": null}}, "rationale": "New III stem and Infectum box; explicit thickening/result contrast.", "evidence": [{"textId": "JTM1.1", "v": 54, "cite": "JTM 1.1/54"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḥlm-1", "date": ""}}, {"id": "0f21183866e3", "entryId": "ḥlm-1", "kind": "note", "stage": "synthesis", "target": {}, "summary": "I bezeichnet Zustandszuwachs, III das verursachte Eindicken. JTM 1.1/54 bietet beide Ebenen als Kochvorgang und Ergebnisadjektiv im selben Kontext.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "JTM1.1", "v": 54, "cite": "JTM 1.1/54"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḥlm-1", "date": ""}}, {"id": "d0c8fdfd02e3", "entryId": "ḥlm-1", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Die Materialkultur-Belege ḥlimo, ḥlime, ḥlímoyo und ḥləmto bezeichnen Holz-/Stoff-/Schichtdicke, auch gemessen in Zentimetern. Das Kopfetymon ḥlīmā macht eine selbständige Adjektivtradition plausibel; sie belegen keine produktive Part act.-Box. Alle acht Kandidaten bleiben als verworfene verbale Analysen dokumentiert.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḥlm-1", "date": ""}}, {"id": "26ac17065310", "entryId": "ḥlm-1", "kind": "note", "stage": "synthesis", "target": {}, "summary": "ḥulmiwo wird nach u-Vokalismus und allgemeiner Wachstumsaussage als Infectum-wa aufgenommen; keine Umdeutung allein nach deutschem Tempus.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḥlm-1", "date": ""}}, {"id": "b1e283a6c3c1", "entryId": "ḥlm-1", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Keine zusätzliche Idiomatic phrases: die Koch- und Größenkontexte enthalten keine gesondert lexikalisierte Wortverbindung.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḥlm-1", "date": ""}}, {"id": "02d17fe19223", "entryId": "ḥlm-1", "kind": "question", "stage": "synthesis", "target": {}, "summary": "III: Welche Preterit-Basis gehört zum belegten maḥləm? Im Eintrag wurde keine unbelegte Form erzeugt.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḥlm-1", "date": ""}}, {"id": "e3ea7fc6cc24", "entryId": "ḥlm-1", "kind": "question", "stage": "synthesis", "target": {}, "summary": "ḥulmiwo (JTM 2.3/4): Infectum-wa und Vokalismus bestätigen.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḥlm-1", "date": ""}}, {"id": "a7296b9fba14", "entryId": "ḥlm-1", "kind": "question", "stage": "synthesis", "target": {}, "summary": "Sind ḥlim-/ḥləmt- lexikalische Adjektive oder im Paradigma eine eigene Form? Eine Part act.-Einordnung ist aus diesen Belegen nicht gesichert.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḥlm-1", "date": ""}}, {"id": "49851d2e3d16", "entryId": "ḥlm-1", "kind": "note", "stage": "synthesis", "target": {"stemId": "ḥlm-1.I", "sense": "1"}, "summary": "Kürbisse werden dick/plump, gegenüber dem ursprünglichen Rahmbeispiel; gleicher Größen-/Konsistenzzuwachs.", "before": null, "after": null, "data": {"type": "extension"}, "rationale": "", "evidence": [{"textId": "JTM2.3", "v": 4, "cite": "JTM 2.3/4"}], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḥlm-1", "date": ""}}]