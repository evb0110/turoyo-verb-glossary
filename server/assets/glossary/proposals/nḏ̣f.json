[{"id": "d84a1879b990", "entryId": "nḏ̣f", "kind": "fix-citation", "stage": "proofreading", "target": {"stemId": "nḏ̣f.II", "boxId": "nḏ̣f.II.t.infectum", "exampleId": "nḏ̣f.II.t.infectum.1", "field": "refs"}, "summary": "Correct the citation for ko-mnaḏ̣af-le to 81/57", "before": "81/51", "after": "81/57", "data": {"confidence": "high"}, "rationale": "81/51 contains Manḥat! Manḥatle and no cleaning verb. In the same narrative, 81/57 ends komokele w komaštele w komnaḏ̣afle, describing the farmer feeding, watering and cleaning the horse. This is the quoted form and context.", "evidence": [], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P039", "date": "2026-10-25"}}, {"id": "3a72074b14c3", "entryId": "nḏ̣f", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "nḏ̣f.III", "boxId": "nḏ̣f.III.t.preterit", "exampleId": "nḏ̣f.III.t.preterit.1", "field": "translation"}, "summary": "Restore the umlaut in säuberte", "before": "sauberte", "after": "säuberte", "data": {"confidence": "high"}, "rationale": "The German verb is säubern; the supplied 7/11 translation also reads säuberte sie mit Alkohol.", "evidence": [{"textId": "R007", "v": 11, "cite": "7/11"}], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P039", "date": "2026-10-25"}}, {"id": "889f12d91349", "entryId": "nḏ̣f", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "nḏ̣f.III", "boxId": "nḏ̣f.III.d.infectum", "exampleId": "nḏ̣f.III.d.infectum.1", "field": "translation"}, "summary": "Correct the accusative article after holt", "before": "holt ein Kessel", "after": "holt einen Kessel", "data": {"confidence": "high"}, "rationale": "Kessel is the direct object of holt and requires einen. The supplied 29/486 translation reads Holt einen Kessel voll Wasser.", "evidence": [{"textId": "R029", "v": 486, "cite": "29/486"}], "priority": 3, "provenance": {"model":