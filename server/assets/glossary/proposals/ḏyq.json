[{"id": "2bbbca485847", "entryId": "ḏyq", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "ḏyq.I", "boxId": "ḏyq.I.t.infectum", "sense": "1"}, "summary": "example for sense 1 in Infectum (JTM 1.1/84)", "before": null, "after": null, "data": {"box": "Infectum", "detransitive": false, "turoyo": "w kmanṭən səkkar stene, hol d ḥole, kdayqile, hol d ḥole, w kmarṯəḥile.", "translation": "Sie bringen Zucker, bis (der Milchreis) süß ist; sie kosten davon, bis er süß ist, dann lassen sie ihn kochen.", "ref": "JTM 1.1/84", "gate": {"ok": true, "reason": null}}, "rationale": "Thin Infectum cell; plural tasting in a cooking procedure, retaining d spelling.", "evidence": [{"textId": "JTM1.1", "v": 84, "cite": "JTM 1.1/84"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḏyq", "date": ""}}, {"id": "022a606daf43", "entryId": "ḏyq", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "ḏyq.I", "boxId": "ḏyq.I.t.infectum", "sense": "1"}, "summary": "example for sense 1 in Infectum (112/148)", "before": null, "after": null, "data": {"box": "Infectum", "detransitive": false, "turoyo": "I naqqa d mḥaḏ̣alle u muklo w komoyəd lač čəkənyoṯe du muklo, du baṣrawo, koxele, kḏoyaqqe, məqqa koṯele kef w ʕašq!", "translation": "Als er das essen fertig hatte und ein paar Stückchen von dem essen nahm und kostete, wie vergnügt wurde er da!", "ref": "112/148", "gate": {"ok": true, "reason": null}}, "rationale": "Brings Infectum to five; assimilated object form kḏoyaqqe with explicit food preparation context.", "evidence": [{"textId": "R112", "v": 148, "cite": "112/148"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḏyq", "date": ""}}, {"id": "9e5e8f913edf", "entryId": "ḏyq", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "ḏyq.I", "boxId": "ḏyq.I.t.preterit", "sense": "1"}, "summary": "example for sense 1 in Preterit (107/48)", "before": null, "after": null, "data": {"box": "Preterit", "detransitive": false, "turoyo": "Mamṭalle i qaḥwa, maḥtəlle qume, lo midole w lo ḏiqole.", "translation": "Sie setzten ihm Kaffee vor: er nahm ihn nicht, kostete ihn nicht.", "ref": "107/48", "gate": {"ok": true, "reason": null}}, "rationale": "Thin Preterit cell; negative tasting of coffee with overt feminine object marking.", "evidence": [{"textId": "R107", "v": 48, "cite": "107/48"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḏyq", "date": ""}}, {"id": "a855d2ed49f3", "entryId": "ḏyq", "kind": "note", "stage": "synthesis", "target": {}, "summary": "All nine occurrences fit inherited taste sense 1. The corpus supplies food, milk and coffee objects without a new sense or idiom.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḏyq", "date": ""}}, {"id": "19d86b7eb95e", "entryId": "ḏyq", "kind": "note", "stage": "synthesis", "target": {}, "summary": "The d spelling at JTM 1.1/84 and 76/124 agrees with the inherited note; it does not justify filing tasting under dyq or dwq.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "JTM1.1", "v": 84, "cite": "JTM 1.1/84"}, {"textId": "R076", "v": 124, "cite": "76/124"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḏyq", "date": ""}}, {"id": "c03d95785f5a", "entryId": "ḏyq", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Finite subject and object suffixes occur in ordinary transitive frames. 113/216 uses d- before a dependent taste clause; 113/218 has a bare dependent verb after ṭreli. These are not a new lexical construction.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R113", "v": 216, "cite": "113/216"}, {"textId": "R113", "v": 218, "cite": "113/218"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḏyq", "date": ""}}, {"id": "d320f4b8e72f", "entryId": "ḏyq", "kind": "note", "stage": "synthesis", "target": {}, "summary": "The Preterit in 112/376 is used in a general conditional frame, while 107/48 describes a negative narrative event; box assignment follows morphology.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R112", "v": 376, "cite": "112/376"}, {"textId": "R107", "v": 48, "cite": "107/48"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḏyq", "date": ""}}, {"id": "074d0c767b70", "entryId": "ḏyq", "kind": "note", "stage": "synthesis", "target": {}, "summary": "The reader's claim of maḏər/ḏyr material merged into this entry is not borne out by the supplied entry. No structural correction is proposed on that assertion.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḏyq", "date": ""}}, {"id": "83af086c133d", "entryId": "ḏyq", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Existing examples at 44/80, 76/124, 105/81 and 112/376 are not duplicated.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R044", "v": 80, "cite": "44/80"}, {"textId": "R076", "v": 124, "cite": "76/124"}, {"textId": "R105", "v": 81, "cite": "105/81"}, {"textId": "R112", "v": 376, "cite": "112/376"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḏyq", "date": ""}}, {"id": "8a006d04b5dc", "entryId": "ḏyq", "kind": "question", "stage": "synthesis", "target": {}, "summary": "44/80: confirm whether the -la in ḏayqola is self-benefit marking or another clitic function; the tasting sense is secure.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḏyq", "date": ""}}, {"id": "9e8616d1ffe5", "entryId": "ḏyq", "kind": "question", "stage": "synthesis", "target": {}, "summary": "If the reported maḏər/ḏyr merge anomaly concerns another source version, provide that record; it is absent from this supplied entry.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/ḏyq", "date": ""}}]