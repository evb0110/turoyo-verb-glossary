[{"id": "8b3add0e3c72", "entryId": "flt", "kind": "fix-citation", "stage": "proofreading", "target": {"stemId": "flt.III", "boxId": "flt.III.t.infectum", "exampleId": "flt.III.t.infectum.1", "field": "refs"}, "summary": "Correct 95/210 → 95/218", "before": "95/210", "after": "95/218", "data": {"confidence": "high"}, "rationale": "95/210 contains the order to give a traveller a tip, without the quoted verb. At 95/218 the returning servant says kem kas menan lə gmaflət, and the edition translates that he will scarcely let one of them escape. This matches both the short quotation and its context. The automatic best match 95/98 is unrelated.", "evidence": [], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P010", "date": "2026-10-25"}}, {"id": "ebd40b76ad9f", "entryId": "flt", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "flt.I", "boxId": "flt.I.t.preterit-intransitive", "exampleId": "flt.I.t.preterit-intransitive.3", "field": "turoyo"}, "summary": "Restore the missing l in aʕlayye after hǧəmme", "before": "hǧəmme aʕayye", "after": "hǧəmme aʕlayye", "data": {"confidence": "high"}, "rationale": "33/32 reads hǧəmme aʕlayye w faliti aʕlayye. The first prepositional form in the quotation has lost its l, while the second still has it; this is a consonant omission, not a clitic-boundary difference.", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P010", "date": "2026-10-25"}}, {"id": "64a6bdae4432", "entryId": "flt", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "flt.I", "field": "gloss"}, "summary": "Correct engleiten → entgleiten in sense 1", "before": "engleiten", "after": "entgleiten", "data": {"confidence": "high"}, "rationale": "The German infinitive meaning slip away is entgleiten. Engleiten is a missing-t typo in this synonym list.", "evidence": [], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P010", "date": "2026-10-25"}}, {"id": "c2a1fb3ca68b", "entryId": "flt", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "flt.I", "boxId": "flt.I.t.preterit-intransitive", "exampleId": "flt.I.t.preterit-intransitive.1", "field": "translation"}, "summary": "Correct als dass Wort → als das Wort", "before": "als dass Wort", "after": "als das Wort", "data": {"confidence": "high"}, "rationale": "Wort requires the neuter article das, not the conjunction dass. The supplied edition translation likewise reads Als das Wort.", "evidence": [], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P010", "date": "2026-10-25"}}, {"id": "7512d9e8223d", "entryId": "flt", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "flt.I", "boxId": "flt.I.t.infectum-wa", "exampleId": "flt.I.t.infectum-wa.2", "field": "translation"}, "summary": "Restore r in hinterliesse", "before": "hinteliesse", "after": "hinterliesse", "data": {"confidence": "high"}, "rationale": "The German verb is hinterlassen; hinteliesse is missing the r of hinter-. Preserve the entry's existing ss spelling.", "evidence": [], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P010", "date": "2026-10-25"}}]