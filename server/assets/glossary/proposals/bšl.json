[{"id": "e241d77b2b8d", "entryId": "bšl", "kind": "fix-citation", "stage": "proofreading", "target": {"stemId": "bšl.II", "boxId": "bšl.II.t.preterit", "exampleId": "bšl.II.t.preterit.3", "field": "refs"}, "summary": "The goose quotation is at 44/42, not 44/43", "before": "44/43", "after": "44/42", "data": {"confidence": "high"}, "rationale": "The supplied 44/42 text begins Haṯe, i ḥurma, nḥəlla i qazo w mbašlola w mqalyola and describes slaughtering, cooking and roasting the goose. Verse 44/43 instead describes taking bread at midday and leaving. Confirmed in inputs/texts/R044.txt.", "evidence": [{"textId": "R044", "v": 42, "cite": "44/42"}, {"textId": "R044", "v": 43, "cite": "44/43"}], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P004", "date": "2026-10-25"}}, {"id": "8c8b5dd4483a", "entryId": "bšl", "kind": "fix-citation", "stage": "proofreading", "target": {"stemId": "bšl.II", "boxId": "bšl.II.t.infectum-wa", "exampleId": "bšl.II.t.infectum-wa.2", "field": "refs"}, "summary": "The winter cooking quotation is at JL 12.14.10", "before": "JL 12.14.11", "after": "JL 12.14.10", "data": {"confidence": "high"}, "rationale": "Direct inspection of inputs/texts/JL12.14.txt places bu=saṯwo i=šərtanayo gšayfiwaynala, w gəmbašliwayna garso, bi=baroše in verse 10. Verse 11 concerns serving the cooked gruel. The automatic best_match verse 9 is also incorrect; it concerns shaping and drying the curd.", "evidence": [{"textId": "JL12.14", "v": 9, "cite": "JL 12.14/9"}, {"textId": "JL12.14", "v": 10, "cite": "JL 12.14/10"}, {"textId": "JL12.14", "v": 11, "cite": "JL 12.14/11"}], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P004", "date": "2026-10-25"}}, {"id": "f6eb9bd0aba7", "entryId": "bšl", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "bšl.I", "boxId": "bšl.I.t.infectum", "exampleId": "bšl.I.t.infectum.3", "field": "translation"}, "summary": "English typo: meet → meat", "before": "the meet/bulgur", "after": "the meat/bulgur", "data": {"confidence": "high"}, "rationale": "The food noun is meat; meet is a verb. The Turoyo phrase explicitly has baṣro.", "evidence": [], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P004", "date": "2026-10-25"}}, {"id": "598a9e2383b8", "entryId": "bšl", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "bšl.II", "boxId": "bšl.II.t.preterit", "exampleId": "bšl.II.t.preterit.1", "field": "translation"}, "summary": "German typo: Früstück → Frühstück", "before": "Früstück", "after": "Frühstück", "data": {"confidence": "high"}, "rationale": "The German noun is Frühstück; the supplied translation of 65/291 also has Frühstück.", "evidence": [{"textId": "R065", "v": 291, "cite": "65/291"}], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P004", "date": "2026-10-25"}}, {"id": "ce5201594aba", "entryId": "bšl", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "bšl.II", "boxId": "bšl.II.t.preterit", "exampleId": "bšl.II.t.preterit.1", "field": "translation"}, "summary": "Missing accusative ending: ein Löffel → einen Löffel", "before": "ein Löffel Linsensuppe", "after": "einen Löffel Linsensuppe", "data": {"confidence": "high"}, "rationale": "Löffel is the masculine accusative object of kochte. The supplied edition has einen Löffel Linsensuppe.", "evidence": [{"textId": "R065", "v": 291, "cite": "65/291"}], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P004", "date": "2026-10-25"}}, {"id": "dccbbf7446b4", "entryId": "bšl", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "bšl.II", "boxId": "bšl.II.d.infectum-wa", "exampleId": "bšl.II.d.infectum-wa.1", "field": "translation"}, "summary": "German typo: Küchen →