[{"id": "f33eb8c6e24a", "entryId": "šwr", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "šwr.II", "boxId": "šwr.II.t.infectum", "sense": "1"}, "summary": "example for sense 1 in Infectum (JTM 1.6/10)", "before": null, "after": null, "data": {"box": "Infectum", "detransitive": false, "turoyo": "<...> I kayəstayḏa gəmšawrina b kulle <...>", "translation": "<...> Am besten wir beraten es mit allen <...>", "ref": "JTM 1.6/10", "gate": {"ok": true, "reason": null}}, "rationale": "Fill Infectum/1 with a planned first-plural consultation and b-marked collective partner.", "evidence": [{"textId": "JTM1.6", "v": 10, "cite": "JTM 1.6/10"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "f44e11768da9", "entryId": "šwr", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "šwr.II", "boxId": "šwr.II.t.infectum", "sense": "1"}, "summary": "example for sense 1 in Infectum (Lahdo Traitor 2/37)", "before": null, "after": null, "data": {"box": "Infectum", "detransitive": false, "turoyo": "Məd kowe medone kəmšawri eban <...>", "translation": "Whatever happens they consult us <...>", "ref": "Lahdo Traitor 2/37", "gate": {"ok": true, "reason": null}}, "rationale": "Fill Infectum/1 with a pronoun consultation partner and a concise habitual frame.", "evidence": [{"textId": "Lahdo_Traitor_2", "v": 37, "cite": "Lahdo Traitor 2/37"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "3d4321ec7c19", "entryId": "šwr", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "šwr.II", "boxId": "šwr.II.t.preterit", "sense": "1"}, "summary": "example for sense 1 in Preterit (MAC NI Aḥmad Aġa Oṣman Aġa/18)", "before": null, "after": null, "data": {"box": "Preterit", "detransitive": false, "turoyo": "<...> dmaḥatle bi+k̇onayḏi dlo+šewər, dlo+mšawaḷḷe ebi. <...>", "translation": "<...> who set up in my field without asking, without asking me. <...>", "ref": "MAC NI Aḥmad Aġa Oṣman Aġa/18", "gate": {"ok": true, "reason": null}}, "rationale": "Fill Preterit/1 with consultation as seeking a landholder's permission; include the noun/restart without assigning it a new box.", "evidence": [{"textId": "MAC_NI_Ahmad_Aga_Osman_Aga", "v": 18, "cite": "MAC NI Aḥmad Aġa Oṣman Aġa/18"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "3443462eee8b", "entryId": "šwr", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "šwr.II", "boxId": "šwr.II.t.infectum", "sense": "1"}, "summary": "example for sense 1 in Infectum (84/4)", "before": null, "after": null, "data": {"box": "Infectum", "detransitive": false, "turoyo": "Fayiši lalyo imomo mšawri b ḥḏoḏe, d ḥatt saymi masale mede w xəlṣi mu qašano.", "translation": "Sie berieten sich Tag und Nacht miteinander, wie sie etwas anstellen könnten, um den Pfarrer los zu werden.", "ref": "84/4", "gate": {"ok": true, "reason": null}}, "rationale": "Bring Infectum/1 to five examples with a sustained day-and-night deliberation context.", "evidence": [{"textId": "R084", "v": 4, "cite": "84/4"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "67c711eb4701", "entryId": "šwr", "kind": "add-example", "stage": "synthesis", "target": {"stemId": "šwr.II", "boxId": "šwr.II.t.preterit", "sense": "1"}, "summary": "example for sense 1 in Preterit (107/61)", "before": null, "after": null, "data": {"box": "Preterit", "detransitive": false, "turoyo": "Komər azzele, səmlele i kəmmayḏe, simole qazi r ruḥe, mšawalle eba.", "translation": "Er ging, machte seine Mütze zum Richter und beriet sich mit ihr.", "ref": "107/61", "gate": {"ok": true, "reason": null}}, "rationale": "Bring Preterit/1 to five examples with an overt personification of a cap as a consultation partner.", "evidence": [{"textId": "R107", "v": 61, "cite": "107/61"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "8e6c6448ef5b", "entryId": "šwr", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "šwr.II", "field": "translation", "boxId": "šwr.II.t.infectum", "exampleId": "šwr.II.t.infectum.2"}, "summary": "Restore the negator: no to do → not to do", "before": "what no to do", "after": "what not to do", "data": {"confidence": "high"}, "rationale": "The English infinitive requires “not”, matching Turoyo lo=saymi and the edition’s contrast between what they should do and leave undone.", "evidence": [{"textId": "R071", "v": 39, "cite": "71/39"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P080", "date": "2026-10-25"}}, {"id": "0681cde1dc35", "entryId": "šwr", "kind": "note", "stage": "synthesis", "target": {}, "summary": "All 35 occurrences fit one consultation meaning. Seeking permission in MAC NI Aḥmad Aġa Oṣman Aġa/18 is a contextual application of consulting, not a new numbered sense.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "3e18361af61f", "entryId": "šwr", "kind": "note", "stage": "synthesis", "target": {}, "summary": "b- marks individual, pronominal and reciprocal partners. Zero-marked ḥḏoḏe is already in the inherited 71/39 example; 75/323 confirms it. Reciprocal meaning uses active II, without requiring a Detransitive section.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R071", "v": 39, "cite": "71/39"}, {"textId": "R075", "v": 323, "cite": "75/323"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "4897bda7d236", "entryId": "šwr", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Do not infer a new government pattern solely from appe (104/4) or l-marked postposed phrases. In PrS 40/35 and 66/56 l marks postposed agents; 111/8 may have the same structure.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R104", "v": 4, "cite": "104/4"}, {"textId": "PrS040", "v": 35, "cite": "PrS 40/35"}, {"textId": "R066", "v": 56, "cite": "66/56"}, {"textId": "R111", "v": 8, "cite": "111/8"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "c26f7d26b3d2", "entryId": "šwr", "kind": "note", "stage": "synthesis", "target": {}, "summary": "šewər in dlo+šewər is not secure Infinitiv evidence. The same source immediately restarts with finite dlo+mšawaḷḷe ebi. The noun šewir at 60/181 supports caution.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R060", "v": 181, "cite": "60/181"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "c2d2e9f19fde", "entryId": "šwr", "kind": "note", "stage": "synthesis", "target": {}, "summary": "Source 60/188 has mṣawalle while the inherited example has mšawalle. Its consultation meaning is clear, but no text correction is made without establishing which transcription the entry intends.", "before": null, "after": null, "data": {"type": "research"}, "rationale": "", "evidence": [{"textId": "R060", "v": 188, "cite": "60/188"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "c70a598b5c60", "entryId": "šwr", "kind": "question", "stage": "synthesis", "target": {}, "summary": "Is šewər in MAC NI Aḥmad Aġa Oṣman Aġa/18 a consultation noun, an Infinitiv or a restart? Which glossary box, if any, should contain it?", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "2ea94d5cc048", "entryId": "šwr", "kind": "question", "stage": "synthesis", "target": {}, "summary": "Verify mṣawalle versus inherited mšawalle at 60/188 against the edition.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "8d4e34b7915c", "entryId": "šwr", "kind": "question", "stage": "synthesis", "target": {}, "summary": "At 111/8, are the l-marked advisers the consulting agents or consultees? At 104/4, confirm the analysis of appe before changing the b- government gloss.", "before": null, "after": null, "data": {}, "rationale": "", "evidence": [], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}, {"id": "3bdc2045aa63", "entryId": "šwr", "kind": "note", "stage": "synthesis", "target": {"stemId": "šwr.II", "sense": "1"}, "summary": "A cap made into a judge can be personified as a consultation partner; the b- construction is unchanged.", "before": null, "after": null, "data": {"type": "extension"}, "rationale": "", "evidence": [{"textId": "R107", "v": 61, "cite": "107/61"}], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "xhigh", "protocol": "SYNTH_PROTOCOL", "run": "synth/r1/šwr", "date": ""}}]