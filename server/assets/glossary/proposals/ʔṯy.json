[{"id": "b48d3cb9fae4", "entryId": "ʔṯy", "kind": "fix-text", "stage": "proofreading", "target": {"field": "translation", "stemId": "ʔṯy.I", "boxId": "ʔṯy.I.t.imperativ", "exampleId": "ʔṯy.I.t.imperativ.3"}, "summary": "Translate hul d- as until, rather than unless.", "before": "unless you reach me", "after": "until you reach me", "data": {"confidence": "high"}, "rationale": "The Turoyo hul d-moṭat l-gabi gives the endpoint of following the track. The edition explicitly translates bis du zu mir hinkommst. Unless introduces a condition instead of that endpoint.", "evidence": [{"textId": "R044", "v": 38, "cite": "44/38"}], "priority": 1, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P088", "date": "2026-10-25"}}, {"id": "9a75747b935c", "entryId": "ʔṯy", "kind": "fix-text", "stage": "proofreading", "target": {"field": "translation", "stemId": "ʔṯy.I", "boxId": "ʔṯy.I.t.preterit-intransitive", "exampleId": "ʔṯy.I.t.preterit-intransitive.2"}, "summary": "Restore the reflexive pronoun in nahm sich einen Mann.", "before": "nahm sie einen Mann", "after": "nahm sich einen Mann", "data": {"confidence": "high"}, "rationale": "The corpus translation at 60/20 reads nahm sich einen Mann. Current sie is a mistaken replacement of sich; the subject is already the Weibchen.", "evidence": [{"textId": "R060", "v": 20, "cite": "60/20"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P088", "date": "2026-10-25"}}, {"id": "b2614ca249af", "entryId": "ʔṯy", "kind": "fix-text", "stage": "proofreading", "target": {"field": "turoyo", "stemId": "ʔṯy.I", "boxId": "ʔṯy.I.t.infinitiv", "exampleId": "ʔṯy.I.t.infinitiv.2"}, "summary": "Restore the locative preposition before the garden.", "before": "d-gawə-d-i=baxča", "after": "b-gawə-d-i=baxča", "data": {"confidence": "high"}, "rationale": "The corpus at 2/119 reads mu kroxo b gawe di baxča. The entry has d-gawə where the quoted text has b gawe. This changes the preposition, beyond clitic-boundary normalization. Retain the entry spelling and boundaries otherwise.", "evidence": [{"textId": "R002", "v": 119, "cite": "2/119"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P088", "date": "2026-10-25"}}, {"id": "31a075b42be7", "entryId": "ʔṯy", "kind": "fix-text", "stage": "proofreading", "target": {"field": "turoyo", "stemId": "ʔṯy.I", "boxId": "ʔṯy.I.t.infinitiv", "exampleId": "ʔṯy.I.t.infinitiv.2"}, "summary": "Restore š in the word for work.", "before": "suġlo", "after": "šuġlo", "data": {"confidence": "high"}, "rationale": "The corpus at 2/119 reads b tə šuġlo, whereas the entry has b-tu suġlo. The consonant s instead of š is not a vowel, stress or clitic-boundary normalization.", "evidence": [{"textId": "R002", "v": 119, "cite": "2/119"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P088", "date": "2026-10-25"}}, {"id": "5bc81737018d", "entryId": "ʔṯy", "kind": "fix-text", "stage": "proofreading", "target": {"field": "translation", "stemId": "ʔṯy.III", "boxId": "ʔṯy.III.t.imperativ", "exampleId": "ʔṯy.III.t.imperativ.1"}, "summary": "Restore the dative plural ending in den Schnittern.", "before": "den Schnitter.", "after": "den Schnittern.", "data": {"confidence": "high"}, "rationale": "The example says l-aḥ=ḥaṣode, with a plural recipient. The corpus at 6/9 explicitly translates den Schnittern.", "evidence": [{"textId": "R006", "v": 9, "cite": "6/9"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P088", "date": "2026-10-25"}}, {"id": "68e22bf6e72b", "entryId": "ʔṯy", "kind": "fix-text", "stage": "proofreading", "target": {"field": "gloss", "stemId": "ʔṯy.I"}, "summary": "Correct the spelling of atmosphärische in sense 7.", "before": "atmosfärische", "after": "atmosphärische", "data": {"sense": "7", "confidence": "high"}, "rationale": "The German adjective is atmosphärisch; the current spelling replaces ph with f.", "evidence": [], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P088", "date": "2026-10-25"}}, {"id": "875276018c51", "entryId": "ʔṯy", "kind": "fix-text", "stage": "proofreading", "target": {"field": "translation", "stemId": "ʔṯy.I", "boxId": "ʔṯy.I.t.ko-preterit", "exampleId": "ʔṯy.I.t.ko-preterit.2"}, "summary": "Correct gesetz to gesetzt.", "before": "gesetz hatten", "after": "gesetzt hatten", "data": {"confidence": "high"}, "rationale": "The past participle of setzen is gesetzt; the supplied translation of 21/43 also has gesetzt hatten.", "evidence": [{"textId": "R021", "v": 43, "cite": "21/43"}], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P088", "date": "2026-10-25"}}, {"id": "384d0ea808c4", "entryId": "ʔṯy", "kind": "fix-text", "stage": "proofreading", "target": {"field": "translation", "stemId": "ʔṯy.I", "boxId": "ʔṯy.I.t.ko-preterit", "exampleId": "ʔṯy.I.t.ko-preterit.2"}, "summary": "Correct the genitive article in König des Ortes.", "before": "König der Ortes", "after": "König des Ortes", "data": {"confidence": "high"}, "rationale": "Ort is masculine, so the genitive is des Ortes. The supplied edition translation at 21/43 confirms this reading.", "evidence": [{"textId": "R021", "v": 43, "cite": "21/43"}], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P088", "date": "2026-10-25"}}, {"id": "4af562e1b58c", "entryId": "ʔṯy", "kind": "fix-text", "stage": "proofreading", "target": {"field": "translation", "stemId": "ʔṯy.I", "boxId": "ʔṯy.I.t.infectum", "exampleId": "ʔṯy.I.t.infectum.7"}, "summary": "Correct hinaub to hinab.", "before": "hinaub", "after": "hinab", "data": {"confidence": "high"}, "rationale": "Hinaub is a typo. The example has naḥitono laltaḥtər, translated Ich stieg weiter ..., which describes downward movement.", "evidence": [], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P088", "date": "2026-10-25"}}, {"id": "b42c876a8d05", "entryId": "ʔṯy", "kind": "fix-text", "stage": "proofreading", "target": {"field": "translation", "stemId": "ʔṯy.I", "boxId": "ʔṯy.I.t.infectum", "exampleId": "ʔṯy.I.t.infectum.19"}, "summary": "Correct the spelling of bisschen.", "before": "bischen", "after": "bisschen", "data": {"confidence": "high"}, "rationale": "The German word is bisschen. The same misspelling in the supplied edition translation does not make it a valid spelling.", "evidence": [{"textId": "R006", "v": 27, "cite": "6/27"}], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P088", "date": "2026-10-25"}}, {"id": "15f7f1c540a8", "entryId": "ʔṯy", "kind": "fix-text", "stage": "proofreading", "target": {"field": "translation", "stemId": "ʔṯy.III", "boxId": "ʔṯy.III.t.preterit", "exampleId": "ʔṯy.III.t.preterit.1"}, "summary": "Correct verscloss to verschloss.", "before": "verscloss", "after": "verschloss", "data": {"confidence": "high"}, "rationale": "The verb is verschließen, with preterite verschloss. The corpus translation at 23/19 has verschloß. The proposed correction retains the entry spelling with ss.", "evidence": [{"textId": "R023", "v": 19, "cite": "23/19"}], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P088", "date": "2026-10-25"}}, {"id": "c320481328d2", "entryId": "ʔṯy", "kind": "fix-text", "stage": "proofreading", "target": {"field": "idiom"}, "summary": "Correct verb agreement in the idiom translation.", "before": "jetzt werde wir", "after": "jetzt werden wir", "data": {"idiomId": "ʔṯy.idiom.9", "confidence": "high"}, "rationale": "The subject wir requires werden. Current werde is missing the final n.", "evidence": [], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P088", "date": "2026-10-25"}}]