[{"id": "1234bd51a1da", "entryId": "nšf", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "nšf.I", "boxId": "nšf.I.t.infectum", "exampleId": "nšf.I.t.infectum.2", "field": "translation"}, "summary": "Correct the drying clause to refer to the plural grapes", "before": "in order for it to dry", "after": "in order for them to dry", "data": {"confidence": "high"}, "rationale": "The objects being dipped, removed and laid on the ground are aʕ=ʕənwe (grapes), followed by plural d-nəšfi. JL 14.9/5 likewise has Trauben followed by sie ... zum Trocknen. Singular 'it' gives the drying clause the wrong number.", "evidence": [{"textId": "JL14.09", "v": 5, "cite": "JL 14.9/5"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P038", "date": "2026-10-25"}}, {"id": "73971b595f40", "entryId": "nšf", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "nšf.I", "boxId": "nšf.I.t.infectum-wa", "exampleId": "nšf.I.t.infectum-wa.1", "field": "turoyo"}, "summary": "Restore ṭ in the word for wheat", "before": "aḥ=ḥet-anək", "after": "aḥ=ḥeṭ-anək", "data": {"confidence": "high"}, "rationale": "The supplied verse JL 17.5/8 reads aḥ=ḥeṭanək. The same source text repeatedly spells wheat ḥeṭe/ḥeṭo, including JL 17.5/1, /3, /5 and /6. The entry has plain t rather than ṭ; this is a consonant change, not clitic or stress normalization.", "evidence": [{"textId": "JL17.05", "v": 8, "cite": "JL 17.5/8"}], "priority": 2, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P038", "date": "2026-10-25"}}, {"id": "8cbf6412c6df", "entryId": "nšf", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "nšf.II", "boxId": "nšf.II.t.infectum-wa", "exampleId": "nšf.II.t.infectum-wa.1", "field": "translation"}, "summary": "German plural typo: 'Kamels' → 'Kamele'", "before": "Die Kamels starben", "after": "Die Kamele starben", "data": {"confidence": "high"}, "rationale": "The standard German plural of Kamel is Kamele. The Turoyo ag=gamle and plural starben both require the plural.", "evidence": [], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P038", "date": "2026-10-25"}}, {"id": "37b544c67510", "entryId": "nšf", "kind": "fix-text", "stage": "proofreading", "target": {"stemId": "nšf.II", "boxId": "nšf.II.t.infectum-wa", "exampleId": "nšf.II.t.infectum-wa.1", "field": "translation"}, "summary": "German agreement typo: 'ihren Fleisch' → 'ihr Fleisch'", "before": "ihren Fleisch", "after": "ihr Fleisch", "data": {"confidence": "high"}, "rationale": "Fleisch is neuter; its accusative possessive is ihr Fleisch, not ihren Fleisch.", "evidence": [], "priority": 3, "provenance": {"model": "gpt-6.1-sol", "effort": "high", "protocol": "PROOF_PROTOCOL", "run": "proof/P038", "date": "2026-10-25"}}]